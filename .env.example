# Gmail SMTP settings used by identity-service for OTP emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-gmail-app-password

# Base64-encoded PKCS#8 private key and X.509 public key for identity-service JWT signing.
# For local development, identity-service generates and persists a key pair under identity-service/.local.
# Set JWT_ALLOW_DEV_KEY_GENERATION=false outside local development.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=identity-key-1
JWT_ISSUER=http://identity-service
JWT_ALLOW_DEV_KEY_GENERATION=true

# Shared JWT verification settings for gateway and resource services
JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json
JWT_SECURITY_ISSUER=http://identity-service

# Cloudinary image storage (media-service)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
